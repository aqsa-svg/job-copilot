# Copy this file to .env and fill in your key.
# Get a free key at https://console.groq.com/keys

GROQ_API_KEY=your_groq_api_key_here

# Optional overrides (defaults shown)
GROQ_MODEL=llama-3.3-70b-versatile
DATABASE_URL=sqlite:///./jobcopilot.db
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# Secret used to sign user login tokens (JWT). A dev default is used if unset,
# but in production set a strong random value: `openssl rand -hex 32`.
JWT_SECRET=
# Optional: how long a login stays valid (days). Default 30.
# JWT_EXPIRE_DAYS=30
